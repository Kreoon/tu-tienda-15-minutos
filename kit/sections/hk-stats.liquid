{% render 'hk-head' %}
<section class="hk hk-dark hk-sec hk-stats">
  <div class="hk-stats__bg">{% render 'hk-img', image: section.settings.bg, asset: section.settings.bg_asset, label: '' %}</div>
  <div class="hk-wrap hk-stats__grid">
    <div class="hk-stats__nums">
      {%- for b in section.blocks -%}<div {{ b.shopify_attributes }}><b>{{ b.settings.number }}</b><span>{{ b.settings.label }}</span></div>{%- endfor -%}
    </div>
    <div class="hk-center">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <a class="hk-btn hk-btn--accent" href="#comprar" style="min-width:min(100%,340px)">{{ section.settings.button }}</a>
    </div>
  </div>
</section>
{% schema %}
{ "name": "HK · Banda de cifras", "settings": [
  { "type": "image_picker", "id": "bg", "label": "Fondo" }, { "type": "text", "id": "bg_asset", "label": "Fondo · archivo del tema" },
  { "type": "text", "id": "heading", "label": "Título" }, { "type": "textarea", "id": "text", "label": "Texto" },
  { "type": "text", "id": "button", "label": "Botón", "default": "Pídelos sin riesgo" } ],
  "blocks": [{ "type": "stat", "name": "Cifra", "settings": [{ "type": "text", "id": "number", "label": "Cifra" }, { "type": "text", "id": "label", "label": "Texto" }] }],
  "presets": [{ "name": "HK · Banda de cifras" }] }
{% endschema %}

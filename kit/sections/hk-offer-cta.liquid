{% render 'hk-head' %}
<section class="hk hk-sec hk-sec--alt hk-center">
  <div class="hk-wrap" style="max-width:720px">
    <div style="max-width:420px;margin:0 auto 24px;aspect-ratio:2/1;border-radius:12px;overflow:hidden">{% render 'hk-img', image: section.settings.image, asset: section.settings.image_asset, label: 'G5 · Producto en sus colores' %}</div>
    <h2>{{ section.settings.heading }}</h2>
    <p class="hk-sub">{{ section.settings.text }}</p>
    {%- for b in section.blocks -%}
      <a class="hk-offer" href="#comprar" style="text-align:left;color:inherit;text-decoration:none" {{ b.shopify_attributes }}>
        {%- if b.settings.tag != blank -%}<span class="hk-offer__tag">{{ b.settings.tag }}</span>{%- endif -%}
        <span>●</span>
        <span><span class="hk-offer__name">{{ b.settings.title }}</span><br><span class="hk-offer__meta">{{ b.settings.meta }}</span></span>
        <span class="hk-offer__price"><b>{{ b.settings.price }}</b><s>{{ b.settings.compare }}</s></span>
        {%- if b.settings.gift != blank -%}<span class="hk-offer__gift">🎁 {{ b.settings.gift }}</span>{%- endif -%}
      </a>
    {%- endfor -%}
    <a class="hk-btn hk-btn--block" href="#comprar" style="margin-top:8px">{{ section.settings.button }}</a>
  </div>
</section>
{% schema %}
{ "name": "HK · Oferta repetida", "settings": [
  { "type": "image_picker", "id": "image", "label": "Imagen" }, { "type": "text", "id": "image_asset", "label": "Imagen · archivo del tema" },
  { "type": "text", "id": "heading", "label": "Título" }, { "type": "textarea", "id": "text", "label": "Texto" },
  { "type": "text", "id": "button", "label": "Botón", "default": "PEDIR AHORA · PAGO CONTRAENTREGA" } ],
  "blocks": [{ "type": "offer", "name": "Oferta", "settings": [
    { "type": "text", "id": "title", "label": "Título" }, { "type": "text", "id": "meta", "label": "Detalle" },
    { "type": "text", "id": "price", "label": "Precio" }, { "type": "text", "id": "compare", "label": "Precio antes" },
    { "type": "text", "id": "tag", "label": "Etiqueta" }, { "type": "text", "id": "gift", "label": "Regalo" } ] }],
  "presets": [{ "name": "HK · Oferta repetida" }] }
{% endschema %}

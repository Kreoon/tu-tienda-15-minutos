{% render 'hk-head' %}
{%- assign thumbs = section.blocks | where: 'type', 'thumb' -%}
{%- assign revs = section.blocks | where: 'type', 'review' -%}
<section class="hk hk-sec{% if section.settings.alt %} hk-sec--alt{% endif %}">
  <div class="hk-wrap hk-center">
    {%- if section.settings.score != blank -%}<p><span class="hk-stars">★★★★★</span> {{ section.settings.score }}</p>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="hk-sub">{{ section.settings.text }}</p>{%- endif -%}
  </div>
  {%- if thumbs.size > 0 -%}
    <div class="hk-strip">{%- for i in (1..3) -%}{%- for t in thumbs -%}{% render 'hk-img', image: t.settings.image, asset: t.settings.image_asset, label: '' %}{%- endfor -%}{%- endfor -%}</div>
  {%- endif -%}
  <div class="hk-wrap">
    <div class="{% if section.settings.layout == 'list' %}hk-revlist{% else %}hk-grid hk-grid--3{% endif %}">
      {%- for b in revs -%}
        <article class="hk-card hk-rev" {{ b.shopify_attributes }}>
          <div class="hk-rev__score">{{ b.settings.rating }} <span class="hk-stars">★★★★★</span>{% if b.settings.demo %}<span class="hk-rev__demo">Reseña demo</span>{% endif %}</div>
          <h3>&ldquo;{{ b.settings.title }}&rdquo;</h3><p>{{ b.settings.text }}</p>
          {%- if section.settings.layout != 'list' -%}
            <div class="hk-rev__head">
              <span class="hk-rev__who">{%- capture src -%}{% render 'hk-src', image: b.settings.avatar, asset: b.settings.avatar_asset, width: 60 %}{%- endcapture -%}{%- if src != blank -%}<img src="{{ src }}" loading="lazy" alt="">{%- endif -%}{{ b.settings.author }}</span>
              <span class="hk-rev__ok">✓ CLIENTE VERIFICADO</span>
            </div>
          {%- endif -%}
          {%- assign tags = b.settings.tags | split: '|' -%}
          <div class="hk-rev__tags">{%- for t in tags -%}<span class="hk-pill">{{ t | strip }}</span>{%- endfor -%}</div>
        </article>
      {%- endfor -%}
    </div>
    {%- if section.settings.button != blank -%}<p class="hk-center" style="margin-top:24px"><a class="hk-btn" href="{{ section.settings.link | default: '#comprar' }}">{{ section.settings.button }}</a></p>{%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "HK · Reseñas", "settings": [
  { "type": "text", "id": "score", "label": "Calificación" },
  { "type": "text", "id": "heading", "label": "Título" }, { "type": "textarea", "id": "text", "label": "Texto" },
  { "type": "select", "id": "layout", "label": "Diseño", "default": "grid", "options": [{ "value": "grid", "label": "3 tarjetas" }, { "value": "list", "label": "Lista" }] },
  { "type": "checkbox", "id": "alt", "label": "Fondo alterno", "default": true },
  { "type": "text", "id": "button", "label": "Botón" }, { "type": "url", "id": "link", "label": "Enlace del botón" } ],
  "blocks": [
    { "type": "thumb", "name": "Foto de cliente", "settings": [{ "type": "image_picker", "id": "image", "label": "Foto" }, { "type": "text", "id": "image_asset", "label": "Foto · archivo del tema" }] },
    { "type": "review", "name": "Reseña", "settings": [
      { "type": "text", "id": "rating", "label": "Nota", "default": "5.0" }, { "type": "text", "id": "title", "label": "Título" },
      { "type": "textarea", "id": "text", "label": "Texto" }, { "type": "text", "id": "author", "label": "Autor" },
      { "type": "image_picker", "id": "avatar", "label": "Avatar" }, { "type": "text", "id": "avatar_asset", "label": "Avatar · archivo del tema" }, { "type": "text", "id": "tags", "label": "Etiquetas (separar con |)" },
      { "type": "checkbox", "id": "demo", "label": "Es reseña demo (reemplazar por real)", "default": true } ] } ],
  "presets": [{ "name": "HK · Reseñas" }] }
{% endschema %}

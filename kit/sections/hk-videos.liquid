{% render 'hk-head' %}
<section class="hk hk-sec{% if section.settings.alt %} hk-sec--alt{% endif %}" style="padding-top:{{ section.settings.pad_top }}px">
  <div class="hk-wrap">
    {%- if section.settings.heading != blank -%}<div class="hk-center"><h2>{{ section.settings.heading }}</h2>{%- if section.settings.text != blank -%}<p class="hk-sub">{{ section.settings.text }}</p>{%- endif -%}</div>{%- endif -%}
    <div class="hk-vids">
      {%- for b in section.blocks -%}
        <div class="hk-vid" {{ b.shopify_attributes }}>
          {%- if b.settings.video != blank -%}
            {{ b.settings.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '400x' }}
          {%- else -%}
            {% render 'hk-img', image: b.settings.image, asset: b.settings.image_asset, label: b.settings.ph, sizes: '220px' %}
          {%- endif -%}
          <span class="hk-vid__play" aria-hidden="true">▶</span>
          {%- if b.settings.caption != blank -%}<span class="hk-vid__cap">{{ b.settings.caption }}</span>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.button != blank -%}<p class="hk-center" style="margin-top:28px"><a class="hk-btn" href="#comprar" style="min-width:min(100%,320px)">{{ section.settings.button }}</a></p>{%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "HK · Videos UGC", "settings": [
  { "type": "text", "id": "heading", "label": "Título" }, { "type": "text", "id": "text", "label": "Subtítulo" },
  { "type": "checkbox", "id": "alt", "label": "Fondo alterno", "default": false },
  { "type": "range", "id": "pad_top", "label": "Espacio arriba", "min": 0, "max": 80, "step": 4, "default": 64 },
  { "type": "text", "id": "button", "label": "Botón" } ],
  "blocks": [{ "type": "video", "name": "Video", "settings": [
    { "type": "video", "id": "video", "label": "Video (vertical)" }, { "type": "image_picker", "id": "image", "label": "Imagen si no hay video" }, { "type": "text", "id": "image_asset", "label": "Imagen si no hay video · archivo del tema" },
    { "type": "text", "id": "ph", "label": "Etiqueta placeholder" }, { "type": "text", "id": "caption", "label": "Subtítulo sobre el video" } ] }],
  "presets": [{ "name": "HK · Videos UGC" }] }
{% endschema %}

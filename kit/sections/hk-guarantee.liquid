{% render 'hk-head' %}
<section class="hk hk-sec hk-sec--alt" style="padding-bottom:0">
  <div class="hk-wrap hk-gu__grid">
    <div class="hk-center" style="padding-bottom:48px">
      <div class="hk-seal"><div><b>{{ section.settings.number }}</b><small>{{ section.settings.unit }}</small></div></div>
      <p class="hk-kicker">{{ section.settings.kicker }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p class="hk-sub">{{ section.settings.text }}</p>
    </div>
    <div class="hk-gu__img">{% render 'hk-img', image: section.settings.image, asset: section.settings.image_asset, label: 'W1 · Persona con el producto' %}</div>
  </div>
</section>
{% schema %}
{ "name": "HK · Garantía", "settings": [
  { "type": "text", "id": "number", "label": "Número del sello", "default": "7" }, { "type": "text", "id": "unit", "label": "Unidad", "default": "DÍAS" },
  { "type": "text", "id": "kicker", "label": "Antetítulo" }, { "type": "text", "id": "heading", "label": "Título" },
  { "type": "textarea", "id": "text", "label": "Texto (debe ser la política real)" }, { "type": "image_picker", "id": "image", "label": "Imagen" }, { "type": "text", "id": "image_asset", "label": "Imagen · archivo del tema" } ],
  "presets": [{ "name": "HK · Garantía" }] }
{% endschema %}

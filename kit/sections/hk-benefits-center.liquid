{% render 'hk-head' %}
<section class="hk hk-dark hk-sec" style="background:linear-gradient(180deg,#073f33,var(--hk-primary))">
  <div class="hk-wrap">
    <div class="hk-center"><h2>{{ section.settings.heading }}</h2><p class="hk-sub">{{ section.settings.text }}</p></div>
    <div class="hk-bc__grid">
      <div class="hk-bc__icons">
        {%- for b in section.blocks -%}<div {{ b.shopify_attributes }}><div class="ico">{{ b.settings.icon }}</div><strong>{{ b.settings.title }}</strong></div>{%- endfor -%}
      </div>
      <div class="hk-bc__product">{% render 'hk-img', image: section.settings.image, asset: section.settings.image_asset, label: 'P1 · Producto sin fondo' %}</div>
    </div>
  </div>
</section>
{% schema %}
{ "name": "HK · Beneficios+producto", "settings": [
  { "type": "text", "id": "heading", "label": "Título" }, { "type": "textarea", "id": "text", "label": "Subtítulo" },
  { "type": "image_picker", "id": "image", "label": "Producto (PNG sin fondo)" }, { "type": "text", "id": "image_asset", "label": "Producto (PNG sin fondo) · archivo del tema" } ],
  "blocks": [{ "type": "item", "name": "Beneficio", "settings": [{ "type": "text", "id": "icon", "label": "Icono (emoji o 1–3 letras)" }, { "type": "text", "id": "title", "label": "Texto" }] }],
  "presets": [{ "name": "HK · Beneficios+producto" }] }
{% endschema %}
